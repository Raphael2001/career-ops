# career-ops monitor — environment variables
#
# Normally you don't need this file at all: `docker compose up -d monitor`
# (see ../docker-compose.yml) supplies both vars below automatically --
# LITELLM_BASE_URL as the compose network's internal DNS name for the
# litellm service, LITELLM_MASTER_KEY forwarded from the host .env.
#
# Only needed for `yarn dev` run directly on the docker host outside a
# container (e.g. to iterate on the UI without a full image rebuild each
# time) -- cp .env.example .env.local and fill in:

# Same value as litellm's own LITELLM_MASTER_KEY (see
# ../deploy/litellm/README.md).
# LITELLM_MASTER_KEY=

# Only needed outside docker compose -- inside it, the default
# (http://litellm:4000, the compose service's internal DNS name) is
# already correct.
# LITELLM_BASE_URL=http://localhost:4001
