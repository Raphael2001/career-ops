# career-ops monitor — environment variables
# cp .env.example .env.local
#
# No secrets needed here. Every data source (litellm, the discovery scan,
# docker) is read over SSH to the host that already has them -- litellm's
# own .env supplies LITELLM_MASTER_KEY there, this app never needs its own
# copy of it.

# SSH access to the host running docker compose (career-ops, litellm,
# litellm-db). Must be an entry in your ~/.ssh/config with a working key,
# reachable with no password prompt (BatchMode).
# MONITOR_SSH_HOST=linux-claw
# MONITOR_REMOTE_PROJECT_DIR=~/career-ops
